{
  "schemaVersion": 1,
  "id": "com.example.prompt-pack",
  "version": "1.0.0",
  "name": { "zh-CN": "示例提示词包", "en": "Example prompt pack" },
  "description": {
    "zh-CN": "两个 AI 提示词模板，演示插件如何注册提示词。",
    "en": "Two AI prompt templates demonstrating declarative prompt contributions."
  },
  "author": { "name": "Modu contributors", "url": "https://github.com/sobranie2406/modu" },
  "license": "CC0-1.0",
  "minAppVersion": "1.3.1",
  "capabilities": ["ai:prompt-pack"],
  "contributes": [
    {
      "kind": "aiSkill",
      "schema": 1,
      "id": "deep-summary",
      "name": { "zh-CN": "深度摘要", "en": "Deep summary" },
      "description": {
        "zh-CN": "按论点—证据—结论归纳。",
        "en": "Claim–evidence–conclusion summary."
      },
      "prompt": "阅读当前内容，按“核心结论 / 论证链 / 证据 / 隐含假设”四部分输出。每一部分用要点列出，不要复述原文。",
      "enabled": true
    },
    {
      "kind": "aiSkill",
      "schema": 1,
      "id": "socratic-questions",
      "name": { "zh-CN": "苏格拉底提问", "en": "Socratic questions" },
      "description": {
        "zh-CN": "针对当前内容提出 3 个追问。",
        "en": "Three follow-up questions about the current content."
      },
      "prompt": "针对当前内容提出 3 个由浅入深的追问，并说明每个问题想检验什么。",
      "enabled": true
    }
  ],
  "hostApi": 1
}
